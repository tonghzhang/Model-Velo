MODEL_VELO_HTTP_ADDR=:8080
MODEL_VELO_ENVIRONMENT=development
MODEL_VELO_PROVIDER_KEYS_JSON={"providers":[{"provider_id":"upstream","keys":[{"id":"primary","secret":"replace-with-provider-key"},{"id":"secondary","secret":"replace-with-second-provider-key"}]}]}
MODEL_VELO_SHUTDOWN_TIMEOUT=10s

MODEL_VELO_POSTGRES_DB=model_velo
MODEL_VELO_POSTGRES_USER=model_velo
MODEL_VELO_POSTGRES_PASSWORD=replace-with-local-postgres-password
MODEL_VELO_POSTGRES_PORT=5432
MODEL_VELO_POSTGRES_DSN=postgres://model_velo:replace-with-local-postgres-password@localhost:5432/model_velo?sslmode=disable
MODEL_VELO_POSTGRES_TEST_DSN=postgres://model_velo:replace-with-local-postgres-password@localhost:5432/model_velo?sslmode=disable
MODEL_VELO_POSTGRES_MAX_OPEN_CONNS=10
MODEL_VELO_POSTGRES_MAX_IDLE_CONNS=2
MODEL_VELO_POSTGRES_CONNECT_TIMEOUT=5s
MODEL_VELO_POSTGRES_MAX_CONN_LIFETIME=30m
MODEL_VELO_POSTGRES_MAX_CONN_IDLE_TIME=5m
MODEL_VELO_API_KEY_PEPPER=replace-with-at-least-32-random-bytes

MODEL_VELO_REDIS_ADDR=localhost:6379
MODEL_VELO_REDIS_PASSWORD=replace-with-local-redis-password
MODEL_VELO_REDIS_DB=0
MODEL_VELO_REDIS_PORT=6379
MODEL_VELO_REDIS_DIAL_TIMEOUT=5s
MODEL_VELO_REDIS_READ_TIMEOUT=2s
MODEL_VELO_REDIS_WRITE_TIMEOUT=2s
MODEL_VELO_REDIS_POOL_SIZE=20
MODEL_VELO_REDIS_MIN_IDLE_CONNS=2
MODEL_VELO_REDIS_POOL_TIMEOUT=2s
MODEL_VELO_REDIS_STARTUP_POLICY=required
MODEL_VELO_RATE_LIMIT_REQUESTS=60
MODEL_VELO_RATE_LIMIT_WINDOW=1m
MODEL_VELO_RATE_LIMIT_FAILURE_POLICY=fail-closed
MODEL_VELO_CACHE_TTL=5m
MODEL_VELO_CACHE_ROUTE_VERSION=routes-v1
# Vendor adapter types: openai, anthropic, google, azure, alibaba, cohere, ollama,
# bedrock, cloudflare, mistral, xai, deepseek, zhipu, groq, nvidia, together.
# Declare type explicitly. Use vendor=custom, type=openai-compatible and base_url for another
# compatible endpoint. Each model defaults to text-only; declare image/tools explicitly.
# Routing JSON is required even when it contains only one Provider.
# Ollama does not need an entry in MODEL_VELO_PROVIDER_KEYS_JSON.
MODEL_VELO_ROUTING_JSON={"providers":[{"id":"upstream","type":"openai-compatible","vendor":"custom","base_url":"https://api.example.com","models":["*"],"model_capabilities":{"*":["text"]}}],"routes":[{"model":"*","candidates":[{"provider":"upstream","upstream_model":""}]}]}
MODEL_VELO_BREAKER_FAILURE_THRESHOLD=5
MODEL_VELO_BREAKER_OPEN_DURATION=30s
MODEL_VELO_BREAKER_HALF_OPEN_PROBES=1
MODEL_VELO_QUEUE_MAX_IN_FLIGHT=20
MODEL_VELO_QUEUE_MAX_WAITING=100
MODEL_VELO_QUEUE_WAIT_TIMEOUT=2s
MODEL_VELO_RETRY_MAX_ATTEMPTS=3
MODEL_VELO_RETRY_INITIAL_BACKOFF=100ms
MODEL_VELO_RETRY_MAX_BACKOFF=2s
MODEL_VELO_RETRY_BACKOFF_MULTIPLIER=2
MODEL_VELO_RETRY_JITTER_RATIO=0.2
MODEL_VELO_REQUEST_TIMEOUT=45s
MODEL_VELO_ATTEMPT_TIMEOUT=20s
