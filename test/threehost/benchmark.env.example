# Private addresses reachable from the client host.
GATEWAY_URL=http://10.0.0.20:8080
UPSTREAM_URL=http://10.0.0.30:9000
UPSTREAM_FAIL_URL=http://10.0.0.30:9001
UPSTREAM_FALLBACK_URL=http://10.0.0.30:9002
MODEL_VELO_API_KEY=replace-with-model-velo-api-key

# Use the same run ID on the client, gateway, and upstream hosts.
RUN_ID=
RESULTS_ROOT=
REQUEST_TIMEOUT=30s
COOLDOWN_SECONDS=3
REPETITIONS=3
WARMUP_RATE=50
WARMUP_DURATION=10s

# Closed-loop capacity sweep. This locates the throughput knee.
CAPACITY_VUS="1 2 4 8 16 32 64 128 256"
CAPACITY_DURATION=20s

# Open-loop SLO sweep. Tests continue after errors or dropped iterations.
RATE_SWEEP="100 250 500 750 1000 1500 2000"
RATE_DURATION=30s
PRE_ALLOCATED_VUS=256
MAX_VUS=2048

# SSE is read line by line by test/streamload.
STREAM_REQUESTS=500
STREAM_CONCURRENCY=20
STREAM_MODEL=mock/typical
STREAM_PROMPT_BYTES=200

# Three matched request/response payload profiles.
PAYLOAD_RATE=100
PAYLOAD_DURATION=30s

# Cache behavior. bypass=no-store, unique=miss/write, shared=warm then hit.
CACHE_RATE=500
CACHE_DURATION=30s

# Arrival-rate profiles.
RAMP_STAGES="50:1m,250:2m,500:3m,750:2m,250:1m"
BURST_STAGES="250:2m,1000:1m,250:2m"
PROFILE_PRE_ALLOCATED_VUS=512
PROFILE_MAX_VUS=2048

# Fault and queue-overload cases.
FAULT_RATE=100
FAULT_DURATION=2m
FAULT_RECOVERY_RATE=100
FAULT_RECOVERY_FAILURE_DURATION=45s
FAULT_RECOVERY_HEALTHY_DURATION=45s
QUEUE_RATE=1000
QUEUE_DURATION=2m
QUEUE_PRE_ALLOCATED_VUS=2048
QUEUE_MAX_VUS=4096

# Long-running production profile.
ENDURANCE_RATE=500
ENDURANCE_DURATION=30m
ENDURANCE_PRE_ALLOCATED_VUS=512
ENDURANCE_MAX_VUS=2048

# Redis rate-limit enforcement requires a separate gateway restart with a low
# test threshold. Leave disabled during the main capacity run.
RUN_RATE_LIMIT=false
RATE_LIMIT_TEST_RATE=100
RATE_LIMIT_TEST_DURATION=2m

RUN_CAPACITY=true
RUN_WARMUP=true
RUN_RATE_SWEEP=true
RUN_STREAM_DETAIL=true
RUN_PAYLOAD=true
RUN_CACHE=true
RUN_RAMP=true
RUN_BURST=true
RUN_FAULT=true
RUN_FAULT_RECOVERY=true
RUN_QUEUE_OVERLOAD=true
RUN_ENDURANCE=true
RUN_RELIABILITY=true
SAVE_RAW_METRICS=false
