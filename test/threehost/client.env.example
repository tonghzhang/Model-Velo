# Private addresses reachable from the client host.
GATEWAY_URL=http://10.0.0.20:8080
UPSTREAM_URL=http://10.0.0.30:9000

# Paste the one-time api_key output from bootstrap-tenant on the gateway host.
MODEL_VELO_API_KEY=replace-with-model-velo-api-key

# Set the same ID on all three hosts when collecting one final run. Leave empty
# to let the client runner generate a UTC timestamp.
RUN_ID=

# Main load dimensions. The runner executes both open-model RPS and closed-model
# concurrency unless either RUN_RATE or RUN_VUS is set to false.
DURATION=60s
RATE=50
VUS=20

# For arrival-rate runs, pre-allocate enough VUs for rate × p95 latency.
# RATE is sufficient for mock/instant and mock/typical at their default delays.
PRE_ALLOCATED_VUS=50
MAX_VUS=50

NON_STREAM_MODEL=mock/instant
STREAM_MODEL=mock/typical
REQUEST_TIMEOUT=20s
COOLDOWN_SECONDS=5
REPETITIONS=1
WARMUP_DURATION=10s
WARMUP_RATE=5

RUN_WARMUP=true
RUN_RATE=true
RUN_VUS=true
RUN_STREAM=true
RUN_RELIABILITY=true
SAVE_RAW_METRICS=false
