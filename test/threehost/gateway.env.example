# Copy this file to gateway.env on the gateway host, then replace the three
# private IP addresses. prepare-gateway-env.sh generates the root .env and all
# local secrets from these inputs.
UPSTREAM_MAIN_URL=http://10.0.0.30:9000
UPSTREAM_FAIL_URL=http://10.0.0.30:9001
UPSTREAM_FALLBACK_URL=http://10.0.0.30:9002

# Keep 0.0.0.0 only when the cloud firewall restricts TCP 8080 to the client host.
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
